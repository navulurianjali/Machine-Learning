import math

# Training Dataset
# [Weight, Battery Life, Screen Size]

X = [
    [0.18, 20, 6.1],
    [0.20, 18, 6.5],
    [0.17, 22, 6.0],
    [0.19, 21, 6.4],

    [0.48, 12, 10.2],
    [0.52, 11, 10.5],
    [0.45, 13, 10.1],
    [0.50, 12, 10.8],

    [1.40, 8, 13.3],
    [1.65, 7, 14.0],
    [1.30, 9, 13.6],
    [1.55, 8, 14.2]
]

y = [
    "Smartphone", "Smartphone", "Smartphone", "Smartphone",
    "Tablet", "Tablet", "Tablet", "Tablet",
    "Laptop", "Laptop", "Laptop", "Laptop"
]


# Euclidean Distance
def distance(a, b):

    total = 0

    for i in range(len(a)):
        total += (a[i] - b[i]) ** 2

    return math.sqrt(total)


# KNN
def knn(test, k):

    distances = []

    for i in range(len(X)):

        d = distance(test, X[i])

        distances.append((d, y[i]))

    distances.sort()

    nearest = distances[:k]

    votes = {}

    for d, label in nearest:

        if label not in votes:
            votes[label] = 0

        votes[label] += 1

    return max(votes, key=votes.get)


# Test Data
X_test = [
    [0.21, 19, 6.3],
    [0.47, 12, 10.4],
    [1.48, 8, 13.8],
    [0.16, 23, 6.2],
    [1.60, 7, 14.1]
]

y_test = [
    "Smartphone",
    "Tablet",
    "Laptop",
    "Smartphone",
    "Laptop"
]


# Default K
k = 3

predictions = []

print("KNN CLASSIFICATION")
print("----------------------------")
print("K =", k)

for i in range(len(X_test)):

    prediction = knn(X_test[i], k)

    predictions.append(prediction)

    print("\nTest Instance:", i + 1)
    print("Actual Class:", y_test[i])
    print("Predicted Class:", prediction)


# Accuracy
correct = 0

for i in range(len(y_test)):

    if predictions[i] == y_test[i]:
        correct += 1

accuracy = correct / len(y_test)

print("\n----------------------------")
print("Actual Values:", y_test)
print("Predicted Values:", predictions)
print("Accuracy:", round(accuracy, 3))
print("----------------------------")
