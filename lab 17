import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score

# Dataset
data = {
    'RAM': [2, 3, 4, 4, 6, 8, 8, 12],
    'Storage': [32, 64, 64, 128, 128, 256, 256, 512],
    'Battery': [3000, 3500, 4000, 4500, 4500, 5000, 5500, 6000],
    'Price_Range': [0, 0, 1, 1, 1, 2, 2, 2]
}

df = pd.DataFrame(data)

# Input and output
X = df[['RAM', 'Storage', 'Battery']]
y = df['Price_Range']

# Split data
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

# Model
model = RandomForestClassifier(random_state=42)
model.fit(X_train, y_train)

# Prediction
y_pred = model.predict(X_test)

print("Actual Values:", list(y_test))
print("Predicted Values:", list(y_pred))
print("Accuracy:", accuracy_score(y_test, y_pred))

# New mobile prediction
new_mobile = [[8, 256, 5000]]
print("Predicted Price Range:", model.predict(new_mobile)[0])
